{
  "version": 1,
  "sdk_version": "3.5.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "aylas-puzzles",
      "version": "0.1.0",
      "title": "Aylas Puzzles"
    },
    "tools": [
      {
        "name": "list_puzzle_types",
        "title": "List puzzle types",
        "description": "List every puzzle type with the ages it suits.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_puzzle",
        "title": "Get a puzzle",
        "description": "Make a puzzle for a child's age. The same seed always gives the same puzzle; the answer is not included.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "age": {
              "type": "integer",
              "minimum": 3,
              "maximum": 10,
              "description": "Child's age, 3 to 10."
            },
            "type": {
              "type": "string",
              "maxLength": 40,
              "description": "Puzzle type id from list_puzzle_types; omit for any."
            },
            "seed": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000000000,
              "description": "Seed for a repeatable puzzle; omit for a random one."
            }
          },
          "required": [
            "age"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "check_answer",
        "title": "Check an answer",
        "description": "Check a child's answer to a puzzle from get_puzzle, using its age, type and seed.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "age": {
              "type": "integer",
              "minimum": 3,
              "maximum": 10,
              "description": "Age used in get_puzzle."
            },
            "type": {
              "type": "string",
              "maxLength": 40,
              "description": "Puzzle type returned by get_puzzle."
            },
            "seed": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000000000,
              "description": "Seed returned by get_puzzle."
            },
            "answer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The answer, in the format get_puzzle described."
            }
          },
          "required": [
            "age",
            "type",
            "seed",
            "answer"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
